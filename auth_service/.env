PORT=8082
HOST=0.0.0.0

# When running in Docker (docker-compose.dev.yml): use Docker internal hostname
# When running on host (npm run dev):              use http://localhost:9090
KEYCLOAK_URL=http://keycloak:8080

KEYCLOAK_CLIENT_ID=pos-auth-service
# Copy from Keycloak Admin: Realm → Clients → pos-auth-service → Credentials tab
KEYCLOAK_CLIENT_SECRET=REPLACE_ME
