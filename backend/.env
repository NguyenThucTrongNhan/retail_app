PORT=8080
HOST=0.0.0.0

# Local dev only (npm run dev on host, not Docker)
# When running in Docker use docker-compose.dev.yml — it overrides these values.
DATABASE_URL=postgres://shop_admin:LocalShopSecretPassword123!@localhost:5432/retail_store

# Keycloak URL depends on where backend runs:
#   In Docker (docker-compose.dev.yml): http://keycloak:8080  ← Docker internal hostname
#   On host (npm run dev):              http://localhost:9090  ← mapped host port
KEYCLOAK_URL=http://keycloak:8080

# ── Image fetch (images:fetch script) ─────────────────────────────────────────
# Default provider is 'ddg' (DuckDuckGo) — no key or account needed.
# Set these only if you use --provider google or --provider bing.

# Google Custom Search — free Google account, 100 queries/day, no credit card
# Setup: see comments in backend/src/scripts/fetch_product_images.ts
GOOGLE_CSE_KEY=REPLACE_ME
GOOGLE_CSE_ID=REPLACE_ME

# Bing Image Search — requires Azure account (1,000/month free)
BING_IMAGE_SEARCH_KEY=REPLACE_ME

# Vision service URL — used by images:embed script
VISION_SERVICE_URL=http://localhost:8081
