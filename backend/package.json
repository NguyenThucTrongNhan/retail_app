{
  "name": "retail-backend-api",
  "version": "1.0.0",
  "description": "Local Fastify sync server for retail store mobile app",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed:db": "tsx src/seed.ts",
    "images:fetch": "tsx src/scripts/fetch_product_images.ts",
    "images:embed": "tsx src/scripts/embed_products.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/postgres": "^5.2.2",
    "@fastify/static": "^7.0.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.5.1",
    "jose": "^5.9.3",
    "pg": "^8.11.3",
    "pgvector": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
