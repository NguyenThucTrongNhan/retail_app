# Project-root .env — read by docker-compose.dev.yml and docker-compose.prod.yml
# Do NOT commit this file to git.

# Keycloak client secret — copy from Keycloak Admin Console:
# Realm → Clients → pos-auth-service → Credentials tab
KEYCLOAK_CLIENT_SECRET=REPLACE_ME

KEYCLOAK_CLIENT_ID=pos-auth-service

# Local PostgreSQL credentials (used by docker-compose.dev.yml via host.docker.internal)
POSTGRES_USER=shop_admin
POSTGRES_PASSWORD=LocalShopSecretPassword123!
POSTGRES_DB=retail_store
