# =============================================================================
# RETAIL APP — ROOT .gitignore
# Covers: Flutter (mobile/), Node.js Fastify (backend/), Python FastAPI (vision_service/)
# Target platforms: Web (Chrome), Android, iOS only.
# =============================================================================


# =============================================================================
# FLUTTER / DART  (mobile/)
# Note: mobile/.gitignore (generated by flutter create) handles Dart/build
# ignores inside the mobile/ directory. This section covers what it misses.
# =============================================================================

# Isar generated files — regenerate with:
#   flutter pub run build_runner build --delete-conflicting-outputs
mobile/**/*.g.dart
mobile/**/*.freezed.dart

# Non-target desktop platforms — this MVP targets Web + Android + iOS only
mobile/linux/
mobile/macos/
mobile/windows/

# Android — build cache and signing (scaffold source files are committed)
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/captures/

# iOS — CocoaPods and generated artefacts (scaffold source files are committed)
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/ephemeral/
mobile/ios/ServiceDefinitions.json
mobile/ios/Runner/GeneratedPluginRegistrant.*

# Web — service worker is generated at build time, not a source file
mobile/web/flutter_service_worker.js


# =============================================================================
# NODE.JS / TYPESCRIPT  (backend/)
# =============================================================================

# Dependencies — created by: npm install
backend/node_modules/

# TypeScript compiled output — created by: npm run build
backend/dist/

# Product images — binary, potentially large; managed outside git
backend/uploads/*
# Keep the folder itself so @fastify/static does not error on startup
!backend/uploads/.gitkeep

# Local env overrides (base .env with local dev defaults stays committed)
backend/.env.local
backend/.env.*.local

# Logs
backend/*.log
backend/logs/


# =============================================================================
# PYTHON  (vision_service/)
# =============================================================================

# Virtual environment — created by: python -m venv .venv
vision_service/.venv/
vision_service/venv/
vision_service/env/

# Byte-compiled files
vision_service/__pycache__/
vision_service/**/__pycache__/
vision_service/**/*.pyc
vision_service/**/*.pyo
vision_service/**/*.pyd

# Packaging artefacts
vision_service/*.egg-info/
vision_service/dist/
vision_service/build/

# Test / coverage cache
vision_service/.pytest_cache/
vision_service/.coverage

# Jupyter checkpoints
vision_service/.ipynb_checkpoints/


# =============================================================================
# EDITORS & OS
# =============================================================================

# VS Code — personal settings only; shared workspace config is kept
.vscode/settings.json
.vscode/*.code-workspace

# Claude Code — local personal settings
.claude/settings.local.json

# macOS
.DS_Store
**/.DS_Store

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# =============================================================================
# SECRETS & SENSITIVE FILES — never commit these
# =============================================================================
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx

# Generic temp / log
*.log
*.tmp
*.temp
tmp/
temp/
